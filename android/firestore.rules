rules_version = '2';

// 일감장부 서버 저장 규칙
//
// 뼈대는 하나입니다. "그 업체의 식구 명단에 있는 사람만 그 업체 자료를 본다."
// 명단에 없으면 업체 번호를 알아내도 아무것도 읽히지 않습니다.
//
// 파이어베이스 콘솔 > Firestore Database > 규칙 에 그대로 붙여 넣고 게시하세요.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function memberDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid));
    }

    function isMember(shopId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid));
    }

    // 사장님만 적고 마감할 수 있습니다. 가족은 보기만 합니다.
    function isOwner(shopId) {
      return isMember(shopId) && memberDoc(shopId).data.role == 'owner';
    }

    // 내가 어느 업체에 붙어 있는지. 내 것만 봅니다.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // 업체를 만들거나 초대로 들어갈 때 본인 것만 씁니다.
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // 초대 번호.
    // 번호를 아는 사람은 읽어서 들어갈 수 있어야 하므로 로그인만 하면 읽힙니다.
    // 여섯 자리라 찍어 맞힐 수 있으니 사흘 뒤 만료되고 한 번 쓰면 지워집니다.
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.shopId);
      allow delete: if signedIn();
      allow update: if false;
    }

    match /shops/{shopId} {
      // 업체를 새로 열 때는 자기를 사장님으로 적는 경우만 허용합니다.
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isMember(shopId);
      allow update, delete: if isOwner(shopId);

      // 식구 명단
      match /members/{uid} {
        allow read: if isMember(shopId);
        // 업체를 처음 열 때 자기 자신을 사장님으로 넣거나,
        // 초대로 들어오며 자기 자신을 '보기만' 으로 넣는 경우만 허용합니다.
        allow create: if signedIn() && request.auth.uid == uid && (
          request.resource.data.role == 'owner' ||
          request.resource.data.role == 'viewer'
        );
        // 내보내기는 사장님만. 스스로 나가는 것은 언제나 됩니다.
        allow delete: if isOwner(shopId) || (signedIn() && request.auth.uid == uid);
        allow update: if isOwner(shopId);
      }

      // 장부 자료 — 식구는 모두 읽고, 사장님만 씁니다.
      match /{collection}/{docId} {
        allow read: if isMember(shopId);
        allow write: if isOwner(shopId);
      }
    }
  }
}
